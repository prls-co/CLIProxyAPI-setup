# Canonical local environment for this checkout.
# Copy to .env, chmod 600, and never commit or print the values.

COMPOSE_PROJECT_NAME=cliproxyapi-setup
TZ=America/Los_Angeles

# CPA and CPA Manager Plus credentials.
CPA_API_KEY=
CPA_MANAGEMENT_KEY=
CPAMP_ADMIN_KEY=

# Cloudflare tunnel and deployment configuration.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_NAME=prls.co
CPA_TUNNEL_NAME=shaman-cpa
CPA_TUNNEL_TOKEN=
CPA_TUNNEL_ORIGIN=http://cpa-edge:4000
CPA_PUBLIC_HOSTNAME=cpa.prls.co
CPA_ORIGIN_HOSTNAME=
CPA_SWITCH_TIMEOUT_SECONDS=180

# Canonical local test and probe endpoints.
CPA_BASE_URL=https://cpa.prls.co/v1
CPA_LOCAL_BASE_URL=http://127.0.0.1:8317
CPAMP_BASE_URL=http://127.0.0.1:18317
CPAMP_PUBLIC_URL=https://cpa.prls.co
PUBLIC_BASE_URL=https://cpa.prls.co/v1
MODEL=gpt-5.4-mini
CPA_VERSION=v7.2.135

# Other local provider, repository, and test credentials used by this checkout.
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GITHUB_PAT=
GITHUB_TOKEN=
GROQ_API_KEY=
GROQ_API_KEY_TMP=
LAMBDA_API_KEY=
NOVITA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
SAMBANOVA_API_KEY=
TEST_LOGIN=
TEST_PASSWORD=
VITE_OPENAI_API_KEY=
