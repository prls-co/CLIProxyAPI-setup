# Copy required entries to the ignored mode-0600 .env.local file.
# scripts/init-state.sh creates missing CPA values and keeps protected runtime
# mirrors under state/secrets for Compose, tests, and backup/restore.
CPA_API_KEY=
CPA_MANAGEMENT_KEY=
CPAMP_ADMIN_KEY=

# Optional public response identity. Defaults to this machine's hostname.
CPA_ORIGIN_HOSTNAME=

# Public Cloudflare deployment only. Do not populate for a local-only runtime.
CLOUDFLARE_API_TOKEN=
CPA_TUNNEL_TOKEN=
