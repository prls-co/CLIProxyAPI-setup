diff --git a/internal/auth/codex/token_owner_linux.go b/internal/auth/codex/token_owner_linux.go
new file mode 100644
index 0000000..6cc5f2c
--- /dev/null
+++ b/internal/auth/codex/token_owner_linux.go
@@ -0,0 +1,18 @@
+package codex
+
+import (
+	"os"
+	"syscall"
+)
+
+// Preserve the operator's ownership when a root container replaces credentials.
+func preserveCredentialFileOwner(path string, replacement *os.File) error {
+	var info syscall.Stat_t
+	if err := syscall.Stat(path, &info); err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return err
+	}
+	return replacement.Chown(int(info.Uid), int(info.Gid))
+}
diff --git a/internal/auth/codex/token_owner_linux_test.go b/internal/auth/codex/token_owner_linux_test.go
new file mode 100644
index 0000000..5df1db4
--- /dev/null
+++ b/internal/auth/codex/token_owner_linux_test.go
@@ -0,0 +1,48 @@
+//go:build linux && cpa_ownership
+
+package codex
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+// This kernel boundary runs as root in the maintained image's build gate.
+func TestWriteJSONFileAtomicPreservesOwnership(t *testing.T) {
+	if os.Geteuid() != 0 {
+		t.Fatal("ownership qualification requires a root container with CAP_CHOWN")
+	}
+	path := filepath.Join(t.TempDir(), "synthetic.json")
+	if err := os.WriteFile(path, []byte(`{"access_token":"synthetic-old"}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chown(path, 1000, 1000); err != nil {
+		t.Fatal(err)
+	}
+	if err := WriteJSONFileAtomic(path, map[string]any{"access_token": "synthetic-new"}); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner := info.Sys().(*syscall.Stat_t)
+	if owner.Uid != 1000 || owner.Gid != 1000 || info.Mode().Perm() != 0o600 {
+		t.Fatalf("replacement owner/mode = %d:%d %o, want 1000:1000 600", owner.Uid, owner.Gid, info.Mode().Perm())
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value map[string]any
+	if err := json.Unmarshal(raw, &value); err != nil || value["access_token"] != "synthetic-new" {
+		t.Fatal("replacement did not retain the new token data")
+	}
+	files, err := filepath.Glob(path + ".tmp.*")
+	if err != nil || len(files) != 0 {
+		t.Fatal("temporary credential file remains")
+	}
+}
